{
  "name": "borderbench",
  "version": "1.0.0",
  "description": "BorderBench: versioned visual border, corner, and elevation recognition benchmark.",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "render": "bun run src/render.ts",
    "test": "bun run test:python && bun run test:ts && bun run typecheck",
    "test:python": ".venv/bin/python -m pytest",
    "test:ts": "bun test src",
    "typecheck": "tsc --noEmit",
    "benchmark": ".venv/bin/python -m baseline.runner",
    "benchmark:mock": ".venv/bin/python -m baseline.runner --mock --max-tasks 3",
    "build:page": ".venv/bin/python -m baseline.build_page",
    "validate:dataset": ".venv/bin/python -m baseline.validate_dataset --manifest dataset/borderbench-v1/manifest.json",
    "validate:release": ".venv/bin/python -m baseline.releases --release 1.0.0",
    "validate:candidate": ".venv/bin/python -m baseline.validate_dataset --manifest dataset/candidate-rendered/manifest.json"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "playwright": "^1.63.0"
  }
}
